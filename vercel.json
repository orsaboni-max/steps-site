{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "www.stepsnetanya.co.il" }
      ],
      "destination": "https://stepsnetanya.co.il/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "steps-site-xi.vercel.app" }
      ],
      "destination": "https://stepsnetanya.co.il/$1",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:slug(pilates|gym-women|barre|kids|nutrition|pilates-price|pilates-beginners|pilates-or-gym|pilates-postpartum|pilates-ramat-poleg|pilates-ir-yamim|pilates-agamim|pilates-even-yehuda|pilates-teens|barre-beginners|barre-or-pilates|barre-teens|gym-beginners|gym-or-mixed|gym-menopause|yoga-barre-netanya|accessibility|privacy)",
      "destination": "/:slug.html",
      "permanent": true
    },
    {
      "source": "/nutrition-v3.html",
      "destination": "/nutrition.html",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/api/schedule", "destination": "/api/schedule" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" }
      ]
    },
    {
      "source": "/(ads|ads-board|nutrition-v3).html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).(png|jpg|jpeg|webp|svg|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}